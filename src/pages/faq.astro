---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../config/site';
import { breadcrumbs } from '../lib/jsonld';
import { href } from '../lib/urls';

const crumbs = [{ name: '홈', path: '/' }, { name: '자주 묻는 질문', path: '/faq/' }];

const faqs = [
  {
    q: '이 사이트에서 바로 결제할 수 있나요?',
    a: `아니요. 이 사이트는 상품을 소개하는 페이지이며, 주문·결제는 ${SITE.store.label}에서 진행됩니다. 상품 페이지의 ‘구매하기’ 버튼을 누르면 해당 상품의 스마트스토어 페이지로 이동합니다.`,
  },
  {
    q: '회원가입이 필요한가요?',
    a: '이 사이트에서는 회원가입이나 로그인이 필요하지 않습니다. 결제 시에는 네이버 계정(또는 비회원 주문)으로 스마트스토어에서 진행해 주세요.',
  },
  {
    q: '가격과 재고는 실시간인가요?',
    a: '이 사이트의 가격·재고 정보는 스마트스토어 정보를 주기적으로 반영한 것으로, 실제 결제 시점의 가격·재고·쿠폰 적용 여부는 스마트스토어 상품 페이지 기준입니다.',
  },
  {
    q: '옵션(색상·길이 등)은 어디서 선택하나요?',
    a: '옵션 선택은 스마트스토어 상품 페이지에서 진행합니다. 구매하기 버튼을 눌러 이동한 뒤 원하는 옵션을 선택해 주세요.',
  },
  {
    q: '배송비와 교환·반품은 어떻게 되나요?',
    a: '자세한 내용은 배송·교환·반품 안내 페이지와 각 상품의 스마트스토어 안내를 확인해 주세요.',
  },
];
---

<Base
  title="자주 묻는 질문"
  description={`${SITE.name} 이용 방법, 결제, 배송, 교환·반품에 대해 자주 묻는 질문을 모았습니다.`}
  path="/faq/"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumb items={crumbs} />
  <div class="container">
    <article class="prose">
      <h1>자주 묻는 질문</h1>
      <div style="margin-top:16px">
        {
          faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <p style="margin-top:24px">
        더 궁금한 점은 <a href={SITE.store.url} target="_blank" rel="noopener">{SITE.store.label}</a> 문의를 이용해 주세요.
        · <a href={href('/shipping/')}>배송·교환·반품 안내</a>
      </p>
    </article>
  </div>
</Base>
