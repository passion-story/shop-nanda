---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../config/site';
import { CATEGORIES } from '../config/categories';
import { breadcrumbs } from '../lib/jsonld';
import { href } from '../lib/urls';

const crumbs = [{ name: '홈', path: '/' }, { name: '브랜드 소개', path: '/about/' }];
---

<Base
  title="브랜드 소개"
  description={`${SITE.name}는 섬세한 디테일과 트렌디한 패션아이템을 소개하는 패션 잡화·헤어 액세서리 셀렉트샵입니다.`}
  path="/about/"
  jsonLd={[breadcrumbs(crumbs)]}
>
  <Breadcrumb items={crumbs} />
  <div class="container">
    <article class="prose">
      <h1>{SITE.name} 소개</h1>
      <p class="meta">{SITE.tagline}</p>

      <p>
        {SITE.name}은 <strong>패션 잡화·헤어 액세서리 셀렉트샵</strong>입니다. 섬세한 디테일과 트렌디한 패션아이템을
        직접 고르고, 일상에서 부담 없이 쓸 수 있는 가격으로 소개합니다.
      </p>

      <h2>이런 상품을 만나보실 수 있어요</h2>
      <ul>
        {CATEGORIES.map((c) => <li><a href={href(`/category/${c.slug}/`)}>{c.name}</a> — {c.description}</li>)}
      </ul>

      <h2>이용 방법</h2>
      <ol>
        <li>이 사이트에서 카테고리·베스트·검색으로 마음에 드는 상품을 찾습니다.</li>
        <li>상품 상세 페이지의 <strong>‘네이버 스마트스토어에서 구매하기’</strong> 버튼을 누릅니다.</li>
        <li>{SITE.store.label}에서 옵션을 선택하고 네이버페이 등으로 결제합니다.</li>
      </ol>
      <p>
        회원가입이나 별도 로그인은 필요하지 않으며, 주문·결제·배송·교환·반품은 모두
        <a href={SITE.store.url} target="_blank" rel="noopener">{SITE.store.label}</a>에서 처리됩니다.
      </p>
    </article>
  </div>
</Base>
